# Zero Zone dağıtımı: SquadReader Export API için nginx örneği.
#
# ÖNERİLEN YOL SIRASI
#  (1) WireGuard / özel ağ: Zero Zone web sunucusu reader'a özel ağ adresinden
#      doğrudan ulaşır. nginx GEREKMEZ; TLS gerekmez (tünel şifreli). Bu dosya
#      gerekmez. Dikkat: reader'ın HTTP portunda /export/v1/ DIŞINDA kimlik
#      doğrulamasız yollar da vardır (/api/*, /health...). Bu yüzden reader
#      127.0.0.1'e bağlı kalır ve özel ağ tarafını nginx (aşağıdaki (2) ya da
#      yalnız WireGuard IP'sinde dinleyen sürümü) karşılar; reader'ın portunu
#      doğrudan özel arayüze AÇMAYIN. (KURULUM-TR.md bölüm 10.)
#  (2) TLS sonlandıran nginx + IP izin listesi (bu dosya). Zero Zone farklı
#      makinedeyse (Windows VDS) ve WireGuard yoksa.
#
# Bu dosya ÖRNEKTİR: gerçek alan adı, IP ve sertifika yolu YOKTUR; <...> yer
# tutucuları doldurulmadan `nginx -t` geçmez. DOĞRULANMADI: `nginx -t` bu
# makinede çalıştırılmadı (Linux host gerekli).
#
# Mevcut sitenin nginx/Caddy yapılandırmasıyla ÇAKIŞMAMASI için AYRI bir
# `server` bloğu ve AYRI bir alt alan adı kullanır (ör. <EXPORT_ALT_ALAN_ADI>).
# Bu dosyayı /etc/nginx/conf.d/ altına ayrı bir dosya olarak koyun; mevcut
# sunucu bloklarına dokunmayın. http {} bağlamında include edilmelidir
# (limit_req_zone / log_format http düzeyindedir).
#
# Ne açılır: YALNIZ /export/v1/ yolu (kaynak: sqreader/export_api.py, bu dosya
# yazılırken depoda doğrulandı):
#   GET/HEAD  info, health, matches, matches/<id>, unverified, recordings/<id>
#   GET       live/stream (SSE) ve live/snapshot: YALNIZ reader config'inde
#             `export_live_enabled: true` iken; varsayılan KAPALI, kapalıyken 404
#             (canlı yayın: aşağıdaki "CANLI YAYIN" notu ve KURULUM-TR.md bölüm 10.5)
#   POST      yalnız /export/v1/ack ve /export/v1/control/recording
#             (export_api.py _POST_PATHS; gövde en çok 4096 bayt (control,
#             MAX_BODY_BYTES) ve 24576 bayt (ack, ACK_MAX_BODY_BYTES: 100 kimlik);
#             ack listesi ve kayıt anahtarı durumu sqreader/export_state.py ile
#             veri dizinindeki dosyalarda tutulur)
# Reader'ın diğer tüm yolları (/api/*, /health, /health/deep, /viewer-next...)
# DIŞARI AÇILMAZ: eşleşmeyen her yol 404 döner.
#
# Çoklu örnek: yalnız 7787 açıktır. 7788 için blok yorumdadır; 7788 bilinçli
# olarak açılınca yorumu kaldırın (Zero Zone tarafında baseUrl'e yol ön eki yazılır:
# https://<EXPORT_ALT_ALAN_ADI>/sr/7787 -> .../sr/7787/export/v1/info).

# Erişim logu: Authorization başlığı YAZILMAZ. Bilinçli olarak $http_authorization
# ve sorgu dizesi kullanılmaz; $uri yalnız yolu içerir. Token yalnız başlıktadır.
log_format zz_export '$remote_addr [$time_local] "$request_method $uri" '
                     '$status $body_bytes_sent rt=$request_time';

# İstek hızı: Zero Zone'un çekim döngüsü için makul; ÖLÇÜLMEDİ, canlıda ayarlanır.
limit_req_zone $binary_remote_addr zone=zz_export:1m rate=5r/s;
# Eşzamanlı bağlantı: canlı yayın (SSE) uzun ömürlü bir bağlantıdır; hız yerine
# EŞZAMANLI bağlantı sayısı sınırlanır (bkz. "CANLI YAYIN" notu). Değer, Zero Zone'un
# aynı anda açacağı akış + kayıt indirmesi sayısının rahat üstünde olmalı.
limit_conn_zone $binary_remote_addr zone=zz_export_conn:1m;

server {
    listen 443 ssl;
    # `http2 on;` nginx >= 1.25.1 ister. Daha eski sürümde bu satırı silip
    # `listen 443 ssl http2;` yazın (HTTP/2 zorunlu değildir, kaldırılabilir).
    http2 on;
    server_name <EXPORT_ALT_ALAN_ADI>;

    # Sertifika yolları yer tutucu (Let's Encrypt/ACME ya da kendi CA'nız).
    ssl_certificate     <SERTIFIKA_ZINCIRI_YOLU>;
    ssl_certificate_key <SERTIFIKA_ANAHTARI_YOLU>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 10m;
    server_tokens off;

    access_log /var/log/nginx/zz-export.access.log zz_export;
    error_log  /var/log/nginx/zz-export.error.log warn;

    # IP izin listesi: yalnız Zero Zone web sunucusu. Diğer herkes 403.
    allow <ZZ_WEB_SUNUCUSU_IP>;
    deny  all;

    # Küçük istek gövdesi: GET gövdesiz; POST gövdesi reader tarafında uç başına
    # sınırlıdır (export_api.py): control en çok 4096 bayt (MAX_BODY_BYTES), ack en
    # çok 24576 bayt (ACK_MAX_BODY_BYTES; 100 kimlik x en uzun izinli kimlik 200
    # karakter ~20,4 KB). nginx sınırı bunun ÜSTÜNDE olmalı, yoksa nginx büyük ack
    # paketini reader'a hiç iletmeden 413 verir: 32k.
    client_max_body_size 32k;

    # Eşleşmeyen her yol 404 (reader'ın diğer yolları dışarı açılmaz).
    location / {
        return 404;
    }

    # --- sunucu 7787 (reader 127.0.0.1:8787) ---
    #
    # CANLI YAYIN (SSE) AYNI location'DA: /sr/7787/export/v1/live/stream de bu blokla
    # eşleşir, AYRI location GEREKMEZ. Canlı yayın için bu blokta şunlar şarttır
    # (hepsi aşağıda zaten vardır; canlı yayını açmadan önce SİLMEYİN/DEĞİŞTİRMEYİN):
    #   * proxy_http_version 1.1 + Connection ""  : akış bağlantısı açık kalır
    #   * proxy_buffering off                     : olaylar tamponlanmadan gider (yoksa
    #                                               SSE "donar", olaylar toplu gelir)
    #   * gzip off                                : text/event-stream sıkıştırılmaz
    #                                               (gzip_types'a EKLEMEYİN)
    #   * proxy_read_timeout                      : reader boştayken 5 sn'de bir `hb`
    #                                               olayı yazar; 600 sn bunun çok üstündedir
    #   * chunked_transfer_encoding'i KAPATMAYIN.
    # limit_req yerine limit_conn: limit_req sınırı aşılınca 503 döner; tarayıcı
    # EventSource'u 503'te bağlanmayı BIRAKIR, elle yeniden bağlanan istemci ise
    # yeniden bağlanma fırtınası üretir. Akış için doğru sınır eşzamanlı bağlantıdır
    # (limit_conn). Buradaki limit_req yalnız BAĞLANTI AÇMA hızını sınırlar (akışta tek
    # istektir); burst=20 nodelay, Zero Zone'un yeniden bağlanmasını (1-30 sn geri
    # çekilme) emer. reader'ın kendi sınırı ayrıca `live_max_clients` (aşılınca 503
    # `live_busy`, Retry-After: 5). Bu değerler ÖLÇÜLMEDİ: canlıda ayarlanır.
    location ^~ /sr/7787/export/v1/ {
        limit_except GET HEAD POST {
            deny all;
        }
        limit_req zone=zz_export burst=20 nodelay;
        limit_conn zz_export_conn 20;

        # Ön eki at, /export/v1/ ile reader'a ilet. URI kısmı olan proxy_pass:
        # /sr/7787/export/v1/info -> http://127.0.0.1:8787/export/v1/info
        proxy_pass http://127.0.0.1:8787/export/v1/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Authorization AYNEN iletilir (Bearer token). Başka kimlik başlığı
        # eklenmez; X-Forwarded-*/X-Real-IP eklenmez (reader'ın /health/deep
        # yolu bu başlıkları proxy izi sayar; o yol zaten dışarı açılmaz).
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;

        # Akış: kayıt indirmeleri büyük ve canlı yayın (SSE) uzun ömürlü. Belleğe/diske
        # tamponlama YOK. (Reader ayrıca `X-Accel-Buffering: no` dahil kendi başlıklarını
        # yazar; `proxy_buffering off` yine de şarttır.)
        proxy_buffering off;
        proxy_cache off;
        # İstek gövdesi (yalnız küçük POST) tamponlanır: reader (stdlib) chunked istek almaz.
        proxy_request_buffering on;
        # Reader zaten gzip/zstd verir (Content-Encoding); nginx yeniden sıkıştırmasın.
        gzip off;

        # Büyük yanıt / canlı akış için zaman aşımı (ÖLÇÜLMEDİ; en büyük kayıt indirmesine
        # göre ayarlayın). Canlı akışta reader 5 sn'de bir `hb` yazdığı için read timeout
        # akışı kesmez; kesilirse Zero Zone geri çekilmeyle yeniden bağlanır.
        proxy_connect_timeout 5s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;
        send_timeout          600s;

        # Reader yönlendirme yapmaz; Zero Zone istemcisi yönlendirmeyi hata sayar.
        proxy_redirect off;
    }

    # --- sunucu 7788 (BİLİNÇLİ KARARLA AÇILIR; varsayılan KAPALI) ---
    # 7788 için canlı yayın da AÇILMAZ (7788 reader config'inde export_live_enabled false
    # kalır, Zero Zone'da live.servers'a eklenmez); bu blok açılsa bile canlı yol 404 döner.
    # location ^~ /sr/7788/export/v1/ {
    #     limit_except GET HEAD POST { deny all; }
    #     limit_req zone=zz_export burst=20 nodelay;
    #     limit_conn zz_export_conn 20;
    #     proxy_pass http://127.0.0.1:8788/export/v1/;
    #     proxy_http_version 1.1;
    #     proxy_set_header Connection "";
    #     proxy_set_header Authorization $http_authorization;
    #     proxy_set_header Host $host;
    #     proxy_buffering off;
    #     proxy_cache off;
    #     proxy_request_buffering on;
    #     gzip off;
    #     proxy_connect_timeout 5s;
    #     proxy_send_timeout    600s;
    #     proxy_read_timeout    600s;
    #     send_timeout          600s;
    #     proxy_redirect off;
    # }
}

# HTTP (80) dinlenmez: token düz metin gitmesin. 80 -> 443 yönlendirmesi gerekirse
# yalnız bu alt alan adı için ayrı bir server bloğuyla, Authorization taşımayan bir
# 301 ile yapılır; Zero Zone istemcisi yönlendirmeyi zaten hata sayar.
