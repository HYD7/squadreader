# Zero Zone dağıtımı: kayıt saklama (retention), örnek başına. Örnek adı = oyun portu.
#
# UYARI: bu iş kayıt (.sqrx + .meta.json) dosyalarını SİLER. Export API açıkken
# (bu dağıtımda açık) retention YALNIZ Zero Zone'un onayladığı (POST /export/v1/ack)
# bitmiş kayıtları yaş/boyut kuralıyla siler; onaylanmamış kayıt yalnız disk ACİL
# durumunda (boş alan retention_min_free_gb altına inince) en eskiden silinir ve
# denetim günlüğüne (export_audit.log) yazılır (sqreader/export_state.py başlık
# açıklaması). Zero Zone replay anahtarı (replaySecretFile) yoksa HİÇBİR kayıt
# onaylanmaz: yaş kuralı hiçbir şey silmez, güvenli yöndür ama disk dolabilir;
# KURULUM-TR.md bölüm 13. Aktif kayıt (son --in-progress-min dakikada değişen) ve
# boş alan kuralında en yeni --min-keep kayıt korunur.
#
# UYARI: PARAMETRESİZ `sqreader retention --recordings-dir <DİZİN>` ARTIK config
# varsayılanlarıyla (retention_*) SİLER; upstream varsayılanı 0 = kapalı idi.
# Zamanlayıcıyı etkinleştirmeden önce KURULUM-TR.md bölüm 13'teki `--dry-run`
# komutuyla neyin silineceğine bakın.
#
# Retention bayrakları (sqreader/cli.py build_parser `retention`; verilmeyen sınır
# ilgili config anahtarından gelir): --recordings-dir (ZORUNLU), --max-age-days
# (retention_max_age_days), --max-total-gb (retention_max_total_gb), --min-free-gb
# (retention_min_free_gb), --in-progress-min (retention_in_progress_min),
# --min-keep (retention_min_keep), --require-ack / --no-require-ack
# (retention_require_ack), --include-unverified (retention_include_unverified),
# --unverified-max-age-days (retention_unverified_max_age_days), --state-dir
# (export_state_dir), --dry-run.
# Aşağıdaki komut --max-age-days, --min-free-gb ve --min-keep bayraklarını açıkça
# verir; değerler kodun varsayılanlarıyla aynıdır (90 gün, 5 GB, 3 kayıt) ve
# ÖLÇÜLMEDİ. Kalan sınırlar (max_total_gb, in_progress_min, require_ack,
# unverified) config'ten gelir (SQREADER_CONFIG).
# systemd-analyze verify: çalıştırılmadı (Linux host gerekli).

[Unit]
Description=SquadReader kayıt saklama (retention) - oyun portu %i
ConditionPathIsDirectory=/var/lib/sqreader/%i/recordings

[Service]
Type=oneshot
User=sqreader
Group=sqreader
Environment=SQREADER_CONFIG=/etc/sqreader/%i.config.json
Environment=SQREADER_NET_POLICY=local-only
Environment=HOME=/var/lib/sqreader/%i
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sqreader/venv/bin/sqreader retention \
    --recordings-dir /var/lib/sqreader/%i/recordings \
    --max-age-days 90 \
    --min-free-gb 5 \
    --min-keep 3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sqreader-retention-%i

# Yetenek yok: yalnız kendi veri dizinine yazar.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Kayıt dizini + durum dosyaları (retention_state.json, export_audit.log: veri dizini).
ReadWritePaths=/var/lib/sqreader/%i
UMask=0027
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# Oyun sunucusunu etkilememeli (ölçülmedi).
Nice=19
IOSchedulingClass=idle
CPUQuota=25%
